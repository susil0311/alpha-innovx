# Core production settings
DATABASE_URL=mysql://user:password@host:3306/flood_nexus
JWT_SECRET=replace-with-a-long-random-secret

# Optional normalized source adapters. Each URL must return either
# [{sensorKey,metric,value,unit,observedAt,metadata}] or {observations:[...]}
IMD_DATA_URL=
IMD_DATA_TOKEN=
CWC_DATA_URL=
CWC_DATA_TOKEN=
NWIC_DATA_URL=
NWIC_DATA_TOKEN=
IOT_DATA_URL=
IOT_DATA_TOKEN=
NASA_GPM_DATA_URL=
NASA_GPM_DATA_TOKEN=
BHUVAN_DATA_URL=
BHUVAN_DATA_TOKEN=

# Alert delivery is intentionally not enabled by default.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
