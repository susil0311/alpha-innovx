# Core production settings
DATABASE_URL=mysql://user:password@host:3306/flood_nexus
JWT_SECRET=replace-with-a-long-random-secret

# IndianAPI weather source (server-side only; never expose the key in client code)
INDIAN_API_BASE_URL=https://weather.indianapi.in
INDIAN_API_KEY=
INDIAN_API_CITY=Dharali
INDIAN_API_CITY_ID=

# Optional normalized source adapters. Each URL must return either
# [{sensorKey,metric,value,unit,observedAt,metadata}] or {observations:[...]}
IMD_DATA_URL=
IMD_DATA_TOKEN=
CWC_DATA_URL=
CWC_DATA_TOKEN=
NWIC_DATA_URL=
NWIC_DATA_TOKEN=
NWIC_WIND_CSV_URL=https://nwdp.nwic.gov.in/dataset/c418c625-baad-40b7-bf92-19a625ca7138/resource/beb454fb-8400-44c1-aa92-bf8b4b282efa/download/wind_speed_tel_hr_uttar_pradesh_sw_up_2026_2030.csv
IOT_DATA_URL=
IOT_DATA_TOKEN=
NASA_GPM_DATA_URL=
NASA_GPM_DATA_TOKEN=
BHUVAN_DATA_URL=
BHUVAN_DATA_TOKEN=

# Alert delivery is intentionally not enabled by default.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
